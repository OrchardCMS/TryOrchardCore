      </a>

      <nav aria-label="@T["Primary"]" class="hidden md:block">
        <ul class="flex items-center gap-7 text-sm font-medium">
          @foreach (var (href, spy, text) in navLinks)
          {
            @* .nav-link is the scroll-spy's JS hook; theme.js toggles .is-current on the link for the
               section in view, and the [&.is-current] utilities colour it. *@
            <li><a class="nav-link transition-colors hover:text-leaf focus-visible:outline-2 focus-visible:outline-green-700 [&.is-current]:text-green-600 dark:[&.is-current]:text-accent-bright-hover" href="@anchorPrefix#@href" data-spy="@spy">@text</a></li>
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-center gap-4">
      <button id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="@T["Switch to dark mode"]" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full border border-rule bg-rule transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700 dark:border-night-rule dark:bg-night-tint-strong">
        <svg aria-hidden="true" class="pointer-events-none absolute left-[6px] top-1/2 h-3 w-3 -translate-y-1/2 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg aria-hidden="true" class="pointer-events-none absolute right-[6px] top-1/2 h-3 w-3 -translate-y-1/2 text-ink-soft dark:text-night-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        @* The knob slides right in dark mode: -translate-y-1/2 centres it, dark:translate-x-[22px]
           moves it to the far side of the 44px track (the two utilities compose). *@
        <span class="absolute left-0.5 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-white shadow transition-transform dark:translate-x-[22px] dark:bg-green-900"></span>
      </button>

      <button id="menuBtn" type="button" aria-expanded="false" aria-controls="mobileNav" class="md:hidden -mr-2 p-2 text-green-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700 dark:text-night-heading">
        <span class="sr-only">@T["Menu"]</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>

@* Mobile menu (does not push content): a dimmed backdrop over the page + a panel that drops below
   the sticky header. theme.js sets --header-h to the header height and locks body scroll while
   open. Closes on backdrop click, Escape, or a link. *@
<div id="mobileNavBackdrop" class="hidden md:hidden fixed inset-0 z-30 bg-ink/60 backdrop-blur-sm"></div>
<nav id="mobileNav" aria-label="@T["Primary"]" class="hidden md:hidden fixed inset-x-0 top-[var(--header-h)] z-40 max-h-[calc(100dvh_-_var(--header-h))] overflow-y-auto overscroll-contain border-t border-rule bg-cream shadow-soft dark:border-night-rule dark:bg-night-cream">
  <ul class="mx-auto flex max-w-content flex-col px-6 py-2 text-base font-medium">
    @foreach (var (href, spy, text) in navLinks)
    {
      <li><a class="nav-link block py-3 [&.is-current]:text-green-600 dark:[&.is-current]:text-accent-bright-hover" href="@anchorPrefix#@href" data-spy="@spy">@text</a></li>
    }
  </ul>
</nav>
