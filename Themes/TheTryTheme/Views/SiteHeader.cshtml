@{
    // Rendered by the Layout on every page. The nav always shows so users can get back to the signup
    // page from Success/Confirm/etc. The links target the home page's sections; on the home page itself
    // (OnCreatePage) they stay as in-page anchors so smooth-scroll and the scroll-spy work, while on any
    // other page they are home-prefixed (e.g. /#create) so the click navigates home and then scrolls.
    var onCreatePage = Model.OnCreatePage != null && (bool)Model.OnCreatePage;
    var anchorPrefix = onCreatePage ? "" : Url.Content("~/");

    // The sections of the signup page, in page order. Both the desktop nav and the mobile menu render
    // from this one list, so their data-spy ids stay in sync for the scroll-spy.
    // Href is the scroll target; Spy is the section the scroll-spy watches to highlight the link. They
    // differ for "Create a site": it jumps to the very top of the page (#top) but stays highlighted
    // while the create section is in view.
    var navLinks = new[]
    {
        (Href: "top", Spy: "create", Text: T["Create a site"]),
        (Href: "how", Spy: "how", Text: T["How it works"]),
        (Href: "faq", Spy: "faq", Text: T["FAQ"]),
    };
}

